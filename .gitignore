# Symlinks to source libs (per-developer)
/baileys
/zapo
/whatsmeow
/wa-web
/whatsapp-rust

# The adapter folders share names with source libs that a developer's global
# excludes file may ignore everywhere (`wa-web/` did); repo rules win over it.
!/src/adapters/*/

# Build / package output
node_modules
dist
coverage

# Per-developer state
.auth
.claude

# Native runner build artifacts are ignored via each runner's own .gitignore.