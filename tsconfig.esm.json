{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "outDir": "dist/esm",
        "rootDir": "src",
        "declaration": false,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules", "src/**/__tests__/**"]
}
